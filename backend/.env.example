# Local disposable PostgreSQL database. Replace the placeholder password locally.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/jobfit

# Supabase uses TLS; set false only for a local PostgreSQL server without TLS.
DATABASE_SSL=true

# Express listener and the Vite origin allowed to call the API.
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Seeded accounts from ../database/jobfit.sql; change only if the seed IDs differ.
DEMO_STUDENT_ID=1
DEMO_COMPANY_ID=3
